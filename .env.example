# Copy to .env and fill in. docker-compose.yml reads the DB_* values too.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Shops live on subdomains, so allow them all in dev.
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Base domain shops are created under (acme.localhost, …).
TENANT_USERS_DOMAIN=localhost

DB_NAME=shop
DB_USER=shop
DB_PASSWORD=shop
DB_HOST=localhost
DB_PORT=5432
