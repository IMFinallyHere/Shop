# Production settings: copy to /opt/shop/shared/.env on the server (owner shop, mode 600).
# Generate SECRET_KEY with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
# Main site plus every shop subdomain.
ALLOWED_HOSTS=shop.gokuldelicacy.in,.shop.gokuldelicacy.in
# Shops are created as <slug>.<this>.
TENANT_USERS_DOMAIN=shop.gokuldelicacy.in
# nginx serves the frontend and /api on the same host, so no cross-origin access.
CORS_ALLOWED_ORIGIN_REGEXES=

DB_NAME=shop
DB_USER=shop
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# nginx sits in front and adds X-Forwarded-For; rate limits use the real client IP.
NUM_PROXIES=1
